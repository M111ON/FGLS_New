{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "model": "nvidia-nim/nim-llama",
  "small_model": "llama.cpp/qwen3",
  "plugin": [
    "opencode-agent-live-monitor",
    "opencode-canvas",
    "opencode-agent-skills",
    "@cortexkit/opencode-magic-context",
    "harness-memory/plugin"
  ],
  "mcp": {
    "inbox-manager": {
      "type": "local",
      "command": ["python", "I:/FGLS_new/inbox_mcp_server.py"],
      "enabled": true
    },
    "pogls": {
      "type": "local",
      "command": ["python", "I:/FGLS_new/pogls_mcp_server.py"],
      "enabled": true
    },
    "gdb": {
      "type": "local",
      "command": ["npx", "-y", "@vividcodeai/embedded-gdb-mcp"],
      "enabled": true
    },
    "clangd": {
      "type": "local",
      "command": ["node", "I:/FGLS_new/clangd-mcp-server/dist/index.js"],
      "env": {
        "PROJECT_ROOT": "I:/FGLS_new",
        "CLANGD_PATH": "C:/msys64/mingw64/bin/clangd.exe",
        "COMPILE_COMMANDS_DIR": "I:/FGLS_new",
        "CLANGD_ARGS": "--background-index"
      }
    }
  },
  "lsp": {
    "c": {
      "disabled": true,
      "command": "C:/msys64/mingw64/bin/clangd.exe"
    },
    "cpp": {
      "disabled": true,
      "command": "C:/msys64/mingw64/bin/clangd.exe"
    }
  },
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Llama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3": {
          "name": "Qwen3 local",
          "limit": {
            "context": 4096,
            "output": 1024
          }
        }
      }
    },
    "nvidia-nim": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "options": {
        "baseURL": "http://127.0.0.1:8090/v1"
      },
      "models": {
        "nim-llama": {
          "name": "Llama 3.1 8B Instruct",
          "limit": {
            "context": 4096,
            "output": 2048
          }
        },
        "nim-glm": {
          "name": "GLM 5.2 (753B MoE)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    }
  }
}
