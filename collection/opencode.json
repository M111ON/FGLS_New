{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "model": "llama.cpp/qwen3",
  "small_model": "llama.cpp/qwen3",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3": {
          "name": "Qwen3 local",
          "limit": {
            "context": 4096,
            "output": 1024
          }
        }
      }
    }
  }
}
