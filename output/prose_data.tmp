{
  "project": "POGLS Toolchain",
  "version": "1.0",
  "root": "runner",
  "modules": [
    {
      "name": "core",
      "label": "pogls_core",
      "role": "Foundation Layer",
      "desc": "Platform abstraction, compression API, 144\u00B2 address space, v2 metadata format",
      "tests": 38,
      "doc": "pogls-core",
      "design_note": "Zero external dependencies. Platform layer isolates all OS-specific code (Win32/POSIX). All business-logic headers have zero platform #ifdefs.",
      "files": [
        {"path": "pogls_core/pogls_platform.h", "purpose": "Platform abstraction: VirtualAlloc/mmap, 64-bit file I/O, xorshift32 PRNG", "api": ["pogls_map_file","pogls_alloc_large","pogls_free_large","pogls_fopen","pogls_fseek","pogls_ftell","pogls_fsize","pogls_xorshift32"]},
        {"path": "pogls_core/pogls_platform.c", "purpose": "Platform impl — #ifdef _WIN32 branches for VirtualAlloc/CreateFileMapping/gmtime_s", "api": []},
        {"path": "pogls_core/pogls_compress.h", "purpose": "Compression API: ZSTD per-tensor, auto-fallback to RAW when ratio < 1.1x", "api": ["pogls_compress_tensor","pogls_decompress_tensor"]},
        {"path": "pogls_core/pogls_compress.c", "purpose": "Compression impl — guarded by #define POGLS_USE_ZSTD", "api": []},
        {"path": "pogls_core/pogls_addr.h", "purpose": "144\u00B2=20736 address space. Tier0-3 decomposition: macro(128)\u00D7micro(162). capo() face rotation", "api": ["pogls_addr_from_tensor_name","pogls_addr_decompose","pogls_addr_compose","pogls_addr_capo"]},
        {"path": "pogls_core/pogls_addr.c", "purpose": "Address space impl — FNV-1a hash\u2192macro/micro, capo face offset", "api": []},
        {"path": "pogls_core/pogls_meta.h", "purpose": "POGLS v2 format: header (magic+version+flags) + tensor meta array + optional model meta blob", "api": ["pogls_meta_init","pogls_meta_write","pogls_meta_read","pogls_meta_find"]},
        {"path": "pogls_core/pogls_meta.c", "purpose": "Format read/write — binary search by address or name, v1 backward compat", "api": []},
        {"path": "pogls_core/pogls_core.h", "purpose": "Umbrella include — single #include \"pogls_core.h\" gets all sub-headers", "api": []},
        {"path": "pogls_core/pogls_store.h", "purpose": "Store contract interface — forward-declared PoglsStore with 15 lifecycle/query functions", "api": ["pogls_store_open","pogls_store_close","pogls_store_put","pogls_store_get","pogls_store_delete"]}
      ]
    },
    {
      "name": "gguf",
      "label": "pogls_gguf",
      "role": "GGUF Reader Layer",
      "desc": "Standalone GGUF file parser — no llama.cpp dependency",
      "tests": 9,
      "doc": "pogls-gguf",
      "design_note": "Replaces project's gguf_reader.h + gguf_index.h. Pure stdio — parses header, KV metadata, tensor index. Used by gguf_to_pogls converter.",
      "files": [
        {"path": "pogls_gguf/pogls_gguf.h", "purpose": "Public API: PoglsGgufReader + PoglsGgufIndex structs, open/read/close", "api": ["pogls_gguf_open","pogls_gguf_read_tensor","pogls_gguf_close","pogls_gguf_idx_open","pogls_gguf_idx_close","pogls_gguf_idx_meta_blob"]},
        {"path": "pogls_gguf/pogls_gguf.c", "purpose": "Full GGUF parser — type-size table (31 types), KV skip, tensor index, 64-bit offset", "api": []}
      ]
    },
    {
      "name": "geo",
      "label": "pogls_geo",
      "role": "Geometric Addressing Layer",
      "desc": "Y-triangle coordinate system: 144\u00B2=20736, face jump, triplet topology",
      "tests": 18,
      "doc": "pogls-geo",
      "design_note": "128\u00D7162 = 144\u00B2 = 20736. 128=2\u2077 (head_dim power-of-2), 162=2\u00D73\u2074 (Y-triangle faces). Pure integer math, no float, no hash collision.",
      "files": [
        {"path": "pogls_geo/pogls_geo.h", "purpose": "Geo API: coord decompose/compose, face jump, name hash, triplet table, tier name", "api": ["pogls_geo_coord","pogls_geo_from_coord","pogls_geo_jump","pogls_geo_face_addr","pogls_geo_name_hash","pogls_geo_triplet_vert"]},
        {"path": "pogls_geo/pogls_geo.c", "purpose": "Geo impl — full decompose algorithm, FNV-1a hash, 12-face pentagon triplet table", "api": []}
      ]
    },
    {
      "name": "dram",
      "label": "pogls_dram",
      "role": "Memory Store Layer",
      "desc": "Flat-arena DRamTile: put/get by addr or name, KV ephemeral flag",
      "tests": 8,
      "doc": "pogls-dram",
      "design_note": "Single VirtualAlloc block: [header | directory[512] | data arena]. Linear scan (~25\u00B5s worst-case). No hash, no geo_jump dependency.",
      "files": [
        {"path": "pogls_dram/pogls_dram.h", "purpose": "DRamTile API: open/close, put/get by addr or name, free, save, stats", "api": ["pogls_dram_open","pogls_dram_close","pogls_dram_put","pogls_dram_get","pogls_dram_get_name","pogls_dram_free","pogls_dram_has","pogls_dram_count","pogls_dram_bytes","pogls_dram_save"]},
        {"path": "pogls_dram/pogls_dram.c", "purpose": "DRamTile impl — flat arena layout, POGLS_DRAM_KV_FLAG bit 31 masking", "api": []}
      ]
    },
    {
      "name": "bermuda",
      "label": "pogls_bermuda",
      "role": "Routing + Compression Layer",
      "desc": "Stride-37 geometry router, Diamond Shell 3D cube codec, RLE, shadow bonds",
      "tests": 159,
      "doc": "pogls-bermuda",
      "design_note": "Hilbert encode \u2192 zone mapping \u2192 4 traverse modes (orbit/chiral/cross/hub). Diamond Shell: 4\u00D74\u00D74 cube with 6 rotation orientations.",
      "files": [
        {"path": "pogls_bermuda/pogls_bermuda.h", "purpose": "Bermuda API: route, face scores, diamond compress/decompress, RLE, shadow read/write", "api": ["pogls_bermuda_route","pogls_bermuda_face_scores","pogls_bermuda_diamond_compress","pogls_bermuda_diamond_decompress","pogls_bermuda_rle_compress","pogls_bermuda_rle_decompress","pogls_bermuda_shadow_write","pogls_bermuda_shadow_read"]},
        {"path": "pogls_bermuda/pogls_bermuda.c", "purpose": "Bermuda full impl — Stride-37, Diamond Shell encode, RLE, shadow ring buffer", "api": []}
      ]
    },
    {
      "name": "kv",
      "label": "pogls_kv",
      "role": "KV Cache Layer",
      "desc": "Adaptive KV remap: ENTROPY/GEO/REBUILD delta + 3-lane rail scanner",
      "tests": 9,
      "doc": "pogls-kv",
      "design_note": "classify() compares cur vs base in 4096B strides. Auto-tier: 0-15% ENTROPY (XOR+RLE), 15-85% GEO (byte-offset ranges), 85%+ REBUILD.",
      "files": [
        {"path": "pogls_kv/pogls_kv.h", "purpose": "KV API: skeleton init/destroy, classify, encode/decode, rail init/step/freeze/resume", "api": ["pogls_kv_skeleton_init","pogls_kv_skeleton_destroy","pogls_kv_classify","pogls_kv_encode","pogls_kv_decode","pogls_kv_rail_init","pogls_kv_rail_step","pogls_kv_rail_free","pogls_kv_rail_freeze","pogls_kv_rail_resume"]},
        {"path": "pogls_kv/pogls_kv.c", "purpose": "KV impl — RLE compress/decompress, GEO range delta, 3-lane round-robin", "api": []}
      ]
    },
    {
      "name": "geopixel",
      "label": "pogls_geopixel",
      "role": "Pixel-Level Compression Layer",
      "desc": "64B block codec: FLAT/SMOOTH/GRADIENT/EDGE + Hilbert 2D curve",
      "tests": 39,
      "doc": "pogls-geopixel",
      "design_note": "Classify 64B block by variance: FLAT 2B, SMOOTH/GRADIENT 10B, EDGE 64B raw. 8x8 Hilbert curve for spatial locality.",
      "files": [
        {"path": "pogls_geopixel/pogls_geopixel.h", "purpose": "Geopixel API: encode/decode block, full tensor, Hilbert XY\u2194D, session feed", "api": ["pogls_geopixel_encode_block","pogls_geopixel_decode_block","pogls_geopixel_encode","pogls_geopixel_decode","pogls_geopixel_hilbert_xy_to_d","pogls_geopixel_hilbert_d_to_xy","pogls_geopixel_session_init","pogls_geopixel_session_feed","pogls_geopixel_session_stats"]},
        {"path": "pogls_geopixel/pogls_geopixel.c", "purpose": "Geopixel impl — block classify, variance compute, Hilbert 2D 8-bit, session frame counter", "api": []}
      ]
    },
    {
      "name": "tools",
      "label": "pogls_tools",
      "role": "CLI Tools",
      "desc": "14 command-line utilities for build, inspect, compress, test, debug",
      "tests": 0,
      "doc": "pogls-tools",
      "design_note": "Each tool is a single .c file compiling against pogls_core.lib. See runner/Makefile for build recipes.",
      "files": [
        {"path": "pogls_tools/pogls_compress.c", "purpose": "CLI: compress tensor data with ZSTD", "api": []},
        {"path": "pogls_tools/pogls_decompress.c", "purpose": "CLI: decompress tensor data", "api": []},
        {"path": "pogls_tools/pogls_inspect.c", "purpose": "CLI: inspect .pogls file structure and metadata", "api": []},
        {"path": "pogls_tools/pogls_roundtrip.c", "purpose": "CLI: compress then decompress, verify data integrity", "api": []},
        {"path": "pogls_tools/pogls_build.c", "purpose": "CLI: build .pogls file from GGUF source", "api": []},
        {"path": "pogls_tools/pogls_cat.c", "purpose": "CLI: concatenate multiple .pogls files", "api": []},
        {"path": "pogls_tools/pogls_diff.c", "purpose": "CLI: diff two .pogls files", "api": []},
        {"path": "pogls_tools/pogls_verify.c", "purpose": "CLI: verify .pogls file integrity", "api": []},
        {"path": "pogls_tools/pogls_test.c", "purpose": "CLI: run POGLS core test suite", "api": []},
        {"path": "pogls_tools/addr_resolve.c", "purpose": "CLI: resolve tensor name to 144\u00B2 address", "api": []},
        {"path": "pogls_tools/gguf_dump.c", "purpose": "CLI: dump GGUF file structure and tensor listing", "api": []},
        {"path": "pogls_tools/dramtile_dump.c", "purpose": "CLI: dump DRamTile store contents", "api": []},
        {"path": "pogls_tools/dramtile_bench.c", "purpose": "CLI: benchmark DRamTile put/get performance", "api": []},
        {"path": "pogls_tools/kv_delta_bench.c", "purpose": "CLI: benchmark KV delta encode/decode", "api": []}
      ]
    }
  ]
}
