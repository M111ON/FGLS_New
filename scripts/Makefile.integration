CC ?= gcc
CFLAGS ?= -O2 -Wall -Wextra
INCLUDES := -Isrc -Icore/core -Icore/geo_headers -Icore/pogls_engine -Igeopixel -Iactive_updates

TEST_DIR := tests/integration
BIN_DIR := build/integration
BOND_DIR := build

TESTS := \
  test_dispatch_v2 \
  test_ground_lcgw \
  test_rewind_lcgw \
  test_metatron_route \
  test_frustum_wire \
  test_bond

.PHONY: all clean dirs

all: dirs $(TESTS)

dirs:
	@mkdir -p $(BIN_DIR)

# Integration tests from tests/integration/
$(filter-out test_bond,$(TESTS)): %: $(TEST_DIR)/%.c
	$(CC) $(CFLAGS) $(INCLUDES) $< -o $(BIN_DIR)/$@

# Bond test (standalone, in root)
test_bond: test_pogls_bond.c pogls_bond.h
	$(CC) $(CFLAGS) $(INCLUDES) test_pogls_bond.c -o $(BIN_DIR)/$@

clean:
	rm -rf $(BIN_DIR)
